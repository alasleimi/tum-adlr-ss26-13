{
  "env": {
    "env_id": "Pendulum-v1",
    "max_episode_steps": null
  },
  "eval": {
    "deterministic": true,
    "episodes": 50,
    "every_steps": 100000,
    "seed_base": 100000,
    "seeds": null
  },
  "name": "week1_pendulum_sac",
  "reliability": {
    "collapse_return_threshold": -1000.0,
    "dormant_relative_threshold": 0.1,
    "near_upright_abs_velocity_threshold": 1.0,
    "near_upright_cos_threshold": 0.95,
    "strict_return_thresholds": [
      -250.0,
      -200.0,
      -150.0,
      -100.0
    ],
    "success_max_not_near_upright_streak": 50,
    "success_near_upright_fraction_threshold": 0.8,
    "success_return_threshold": -200.0
  },
  "sac": {
    "alpha_initial_value": 0.01,
    "batch_size": 256,
    "buffer_size": 100000,
    "device": "cpu",
    "gamma": 0.99,
    "learning_starts": 1000,
    "policy_frequency": 2,
    "policy_lr": 0.0001,
    "policy_lr_final": 5e-05,
    "q_lr": 0.0001,
    "q_lr_final": 5e-05,
    "simba_actor_blocks": 1,
    "simba_actor_hidden_dim": 32,
    "simba_backbone": true,
    "simba_block_expansion": 4,
    "simba_c_shift": 3.0,
    "simba_critic_blocks": 2,
    "simba_critic_hidden_dim": 64,
    "simba_critic_max_v": 5.0,
    "simba_critic_min_v": -5.0,
    "simba_critic_num_bins": 51,
    "simba_distributional_critic": true,
    "simba_feature_norm": true,
    "simba_input_shift": true,
    "simba_observation_norm": true,
    "simba_reward_scale_g_max": 5.0,
    "simba_reward_scaling": true,
    "simba_weight_projection": true,
    "target_entropy_scale": -0.5,
    "target_network_frequency": 1,
    "tau": 0.005,
    "total_steps": 100000,
    "update_diagnostics": false,
    "updates_per_step": 1
  },
  "seed": 1,
  "telemetry": {
    "diagnostics_interval_steps": 100000,
    "log_interval_steps": 100000,
    "overwrite": true,
    "replay_inspection_interval_steps": 100000,
    "run_root": "runs",
    "save_model": true,
    "save_replay": true,
    "tensorboard": true,
    "write_eval_returns_csv": true
  }
}